<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F1E5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SMART PANTRY"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#294A32"
            android:gravity="center"
            android:layout_marginTop="32dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MANAGER"
            android:textSize="21sp"
            android:textColor="#71875F"
            android:gravity="center"
            android:letterSpacing="0.25"
            android:layout_marginBottom="12dp"/>

        <View
            android:layout_width="70dp"
            android:layout_height="3dp"
            android:background="#DB879A"
            android:layout_marginBottom="18dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Less waste. Better meals. Smarter choices."
            android:textSize="15sp"
            android:textColor="#52664B"
            android:gravity="center"
            android:layout_marginBottom="42dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome to your pantry"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="#294A32"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What would you like to do today?"
            android:textSize="15sp"
            android:textColor="#71806A"
            android:gravity="center"
            android:layout_marginBottom="28dp"/>

        <Button
            android:id="@+id/btnAddIngredient"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Add Ingredient"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#50764B"
            android:layout_marginBottom="14dp"/>

        <Button
            android:id="@+id/btnRecipes"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Suggested Recipes"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#DB879A"
            android:layout_marginBottom="14dp"/>

        <Button
            android:id="@+id/btnShoppingList"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Shopping List"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#82966C"
            android:layout_marginBottom="14dp"/>

        <Button
            android:id="@+id/btnPantry"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="My Pantry"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#A3B58A"
            android:layout_marginBottom="34dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Healthy Choices Start Here"
            android:textSize="16sp"
            android:textStyle="italic"
            android:textColor="#52664B"
            android:gravity="center"
            android:padding="16dp"
            android:background="#E8EBDD"/>

    </LinearLayout>
</ScrollView>
